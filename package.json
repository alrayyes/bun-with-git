{
  "name": "bun-with-git",
  "version": "0.1.0",
  "private": true,
  "description": "oven/bun with git and ca-certificates baked in, for CI checkout jobs",
  "bugs": {
    "url": "https://github.com/alrayyes/bun-with-git/issues"
  },
  "repository": "https://github.com/alrayyes/bun-with-git",
  "license": "GPL-3.0-or-later",
  "author": "Ryan Kes <511318+alrayyes@users.noreply.github.com>",
  "scripts": {
    "format": "biome check --write .",
    "format:check": "prettier --check \"**/*.{md,yml,yaml}\"",
    "lint": "biome check .",
    "lint:md": "markdownlint-cli2",
    "lint:mechanics": "./scripts/lint-mechanics.sh",
    "lint:prose": "./scripts/lint-prose.sh",
    "prepare": "lefthook install",
    "sort-package-json": "sort-package-json",
    "sort-package-json:check": "sort-package-json --check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "lefthook": "2.1.10",
    "markdownlint-cli2": "0.23.2",
    "prettier": "3.9.6",
    "sort-package-json": "4.0.0"
  },
  "packageManager": "bun@1.3.14",
  "trustedDependencies": [
    "lefthook"
  ]
}
